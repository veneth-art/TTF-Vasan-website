{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TTF Vasan Fan Hub Content",
  "type": "object",
  "properties": {
    "news": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "sourceUrl",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "publishedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "sourceName": {
            "type": "string"
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri"
          },
          "status": {
            "enum": [
              "draft",
              "needs-review",
              "verified",
              "published",
              "rejected"
            ]
          },
          "reviewedBy": {
            "type": [
              "string",
              "null"
            ]
          },
          "reviewedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "dedupeKey": {
            "type": "string"
          }
        }
      }
    },
    "images": {
      "description": "Track every image in docs/02-design/IMAGE_ASSET_MANIFEST.md and approve before production.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "assetId",
          "sourceUrl",
          "identityStatus",
          "rightsStatus",
          "approvalStatus"
        ],
        "properties": {
          "assetId": {
            "type": "string"
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri"
          },
          "sourcePublisher": {
            "type": "string"
          },
          "placement": {
            "type": "string"
          },
          "identityStatus": {
            "enum": [
              "verified-ttf-vasan",
              "not-ttf-vasan",
              "pending"
            ]
          },
          "bikeShown": {
            "type": "boolean"
          },
          "bikeVerificationUrl": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "rightsStatus": {
            "enum": [
              "licensed",
              "permission-granted",
              "permitted-embed",
              "link-only",
              "pending",
              "not-cleared"
            ]
          },
          "altText": {
            "type": "string"
          },
          "approvalStatus": {
            "enum": [
              "approved",
              "pending",
              "rejected"
            ]
          }
        }
      }
    }
  }
}
